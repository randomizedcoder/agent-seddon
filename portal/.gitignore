# Only lib/, pubspec.yaml, analysis_options.yaml, and the committed generated stubs
# (lib/src/gen/) are tracked. Everything below is generated on demand — the platform
# runner scaffolding by `nix run .#portal` (flutter create), the rest by pub/build.
.dart_tool/
.packages
pubspec.lock
build/
.flutter-plugins
.flutter-plugins-dependencies
.metadata
# Platform runners — regenerated by `flutter create` (see nix/portal/default.nix).
/linux/
/web/
/macos/
/windows/
/android/
/ios/
*.iml
.idea/
