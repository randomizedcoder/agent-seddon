<?xml version="1.0"?>
<!--
  nix/clickhouse/users.xml — the agent ClickHouse's server-side access overrides.

  Every login needs a password (security-hardening S16,
  docs/design/security-hardening/08-data-plane-and-secrets.md):

  - `default` is the ADMIN (schema apply, CREATE USER / ROW POLICY, the OTel
    collector's otel_* DDL). Its password is NOT here: `nix run .#clickhouse-up`
    renders a second override, users.d/50-agent-credentials.xml, holding only the
    SHA-256 of the admin password (test/clickhouse/ch_creds.py), and bind-mounts
    it next to this file. The plaintext stays in a 0600 file on the host.
  - agent_writer / agent_reader / agent_viewer are SQL users (schema.sql), created
    unable to log in (`HOST NONE`) until the same helper sets their passwords.

  The `default` user's networks stay open to any address because host connections
  arrive through the container runtime's port forward (the bridge gateway, not
  loopback); `clickhouse-up` publishes the ports on 127.0.0.1 only, and the password
  is what gates the login.
-->
<clickhouse>
    <!-- Server settings (custom_settings_prefixes, users_without_row_policies_can_read_rows)
         live in ./config.xml: users.d ignores them. -->
    <users>
        <default>
            <networks replace="replace">
                <ip>::/0</ip>
            </networks>
            <!-- The admin issues CREATE USER / CREATE ROW POLICY for the schema. -->
            <access_management>1</access_management>
        </default>
    </users>
</clickhouse>
