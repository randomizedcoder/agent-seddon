# nix/checks/review-callgraph.nix
#
# Call-graph (blast-radius) coverage for the code-review flow (component 06).
# Reconstructs a two-commit Go history where `Caller` calls `Target` and `Target`
# changes between base and head, then asserts `agent --review base..head` runs the
# flake-built `agent-go-ast` helper and folds the graph into the grounded context's
# `Call graph` section — surfacing `Caller` as a caller of the changed `Target`.
# Also, from the same diff: `Untouched` (same file, no hunk in it) is not listed as
# changed, a regenerated `*.pb.go` is counted rather than listed, and the test that
# calls `Target` is a count, not a name.
#
# Fully offline + hermetic: the helper is a prebuilt stdlib-only Go binary (no Go
# toolchain or network needed at run time). The agent runs on its wrapper's PATH
# alone (nix/lib/mk-review-check.nix), so the helper must come from there.
{
  pkgs,
  agent,
}:
import ../lib/mk-review-check.nix { inherit pkgs agent; } {
  name = "callgraph";
  reviewConfig = ''
    # Isolate the call-graph collector.
    analyze = false
    signatures = false
    callgraph = true
  '';
  setup = ''
    # A caller in one file, the callee in another.
    cat > caller.go <<'GO'
    package app

    func Caller() int {
    	return Target()
    }
    GO
    cat > target.go <<'GO'
    package app

    func Target() int {
    	return 1
    }

    func Untouched() int {
    	return 0
    }
    GO
    cat > target_test.go <<'GO'
    package app

    func TestTarget() {
    	_ = Target()
    }
    GO
    cat > gen.pb.go <<'GO'
    // Code generated by protoc-gen-go. DO NOT EDIT.

    package app

    func GenOne() int { return 1 }
    GO
    git add -A -f && git commit -q -m base
    base="$(git rev-parse HEAD)"

    # Head: Target changes (so the diff marks it a changed fn / blast-radius root).
    cat > target.go <<'GO'
    package app

    func Target() int {
    	return 2
    }

    func Untouched() int {
    	return 0
    }
    GO
    cat > gen.pb.go <<'GO'
    // Code generated by protoc-gen-go. DO NOT EDIT.

    package app

    func GenOne() int { return 2 }
    GO
    git add -A -f && git commit -q -m head
    head="$(git rev-parse HEAD)"

    ctx="$(agent --config "$cfg" --review "$base..$head")"
    echo "----- generated review context (call graph) -----"
    echo "$ctx"
    echo "-------------------------------------------------"
  '';
  asserts = ''
    echo "$ctx" | grep -q "Grounded review facts"      || fail "no grounded facts block"
    echo "$ctx" | grep -q "Call graph"                 || fail "no call-graph section"
    echo "$ctx" | grep -qE "Target .*called by .*Caller" \
      || fail "blast radius did not surface Caller → Target"
    echo "$ctx" | grep -qE "Target .*called by .*Caller · 1 test" \
      || fail "the test caller of Target is not summarized as a count"
    if echo "$ctx" | grep -qE "^  app\.Untouched "; then
      fail "Untouched (no hunk in it) was listed as a changed fn"
    fi
    if echo "$ctx" | grep -qE "^  app\.GenOne "; then
      fail "a generated fn was listed as changed"
    fi
    echo "$ctx" | grep -q "1 generated fn(s) in the changed lines not shown" \
      || fail "the changed generated fn was not counted"
    echo "$ctx" | grep -q "blast radius of 1 changed fn(s)" \
      || fail "the blast radius should hold exactly the one edited fn"
  '';
  okMsg = "OK: call graph (blast radius) folded into the grounded review context";
}
